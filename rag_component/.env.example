# ─────────────────────────────────────────────────────────────────
# Copy this file and rename it to .env
# Then fill in your actual values
# NEVER commit your .env file to GitHub
# ─────────────────────────────────────────────────────────────────

# ─── Groq API ─────────────────────────────────────────────────────
# Get your FREE key at: https://console.groq.com
# Takes 2 minutes - just sign up and copy the key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Neon Database ────────────────────────────────────────────────
# Copy from your Neon dashboard → Project → Connection Details
# Make sure to use the "pooled" connection string for production
NEON_CONNECTION_STRING=postgresql://username:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ─── Vector Store Settings ────────────────────────────────────────
# Name of the collection inside pgvector (leave as is)
COLLECTION_NAME=hospital_manuals

# ─── Embedding Model ──────────────────────────────────────────────
# Free HuggingFace model - runs locally, no API key needed
# Will auto-download (~90MB) on first run
EMBEDDING_MODEL=all-MiniLM-L6-v2
