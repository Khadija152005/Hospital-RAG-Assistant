# ─────────────────────────────────────────────────────────────────
# Copy this file and rename it to .env
# Then fill in your actual values.
# NEVER commit your real .env file to GitHub.
# ─────────────────────────────────────────────────────────────────

# ─── Groq API ─────────────────────────────────────────────────────
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# ─── Neon Vector Database (RAG) ──────────────────────────────────
# Connection string for your pgvector database
NEON_CONNECTION_STRING=postgresql://username:password@your-neon-host/database?sslmode=require

# ─── Vector Store Settings ────────────────────────────────────────
COLLECTION_NAME=hospital_manuals

# ─── Embedding Model ──────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

############################################################
# Conversational Analytics (PostgreSQL)
############################################################

# PostgreSQL Host
PGHOST=your-neon-host

# Database Name
PGDATABASE=your_database_name

# Database User
PGUSER=your_database_user

# Database Password
PGPASSWORD=your_database_password

# Database Port
PGPORT=5432

# SSL Settings
PGSSLMODE=require
PGCHANNELBINDING=require

############################################################
# Google Gemini
############################################################

GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash

############################################################
# Analytics Service
############################################################

MAX_RESULT_ROWS=50
LLM_MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

############################################################
# Optional Features
############################################################

ENABLE_TEMPLATE_ROUTER=true
ENABLE_LLM_FALLBACK=true
